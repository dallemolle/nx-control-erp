generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMINISTRADOR
  FINANCEIRO
  TESOURARIA
  GESTOR
  AUDITOR
  CONSULTA
  PRODUCAO
  VENDAS
}

enum TipoCategoriaFinanceira {
  RECEITA
  DESPESA
}

enum TipoContaBancaria {
  CORRENTE
  APLICACAO
  INVESTIMENTO
  EMPRESTIMO_FINANCIAMENTO
  CAIXA
}

enum StatusSafraProjeto {
  PLANEJADO
  EM_ANDAMENTO
  ENCERRADO
}

enum MeioPagamento {
  PIX
  DEPOSITO_BANCARIO
}

enum TipoCenarioEstrategico {
  BASE
  OTIMISTA
  PESSIMISTA
}

enum TipoChavePix {
  CPF_CNPJ
  CELULAR
  EMAIL
  ALEATORIA
}

enum TipoContaTerceiro {
  CORRENTE
  POUPANCA
}

enum ClassificacaoFiscal {
  FISCAL
  GERENCIAL
}

enum TipoComprovante {
  // FISCAL
  NFE
  NFCE
  NFSE
  CTE
  NF_PRODUTOR
  NF_ENTRADA
  GUIA_TRIBUTO
  FOLHA_PAGAMENTO
  TARIFA_BANCARIA
  CONTRATO
  OUTRO_FISCAL
  // GERENCIAL
  RECIBO
  PEDIDO_INTERNO
  SEM_COMPROVANTE
}

model Empresa {
  id           String   @id @default(uuid())
  razaoSocial  String
  nomeFantasia String
  cnpjCpf      String   @unique
  moedaPadrao  String   @default("BRL")
  corPrimaria  String?
  logoUrl      String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios             UsuarioEmpresa[]
  filiais              Filial[]
  clientes             Cliente[]
  fornecedores         Fornecedor[]
  auditLogs            AuditLog[]
  cenariosEstrategicos CenarioEstrategico[]
  frutas               Fruta[]
  produtos             Produto[]
  insumos              Insumo[]

  @@map("empresas")
}

model CenarioEstrategico {
  id                     String                 @id @default(uuid())
  empresaId              String
  tipo                   TipoCenarioEstrategico
  crescimentoReceita     Decimal                @db.Decimal(7, 4)
  crescimentoCustos      Decimal                @db.Decimal(7, 4)
  capexPercentualReceita Decimal                @db.Decimal(7, 4)
  novoEndividamentoAnual Decimal                @db.Decimal(18, 2)
  taxaJurosAnual         Decimal                @db.Decimal(7, 4)
  criadoEm               DateTime               @default(now())
  atualizadoEm           DateTime               @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo])
  @@index([empresaId])
  @@map("cenarios_estrategicos")
}

model Filial {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  cnpjCpf      String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuariosFiliais         UsuarioEmpresaFilial[]
  centrosCusto            CentroCusto[]
  centrosLucro            CentroLucro[]
  safras                  Safra[]
  projetos                Projeto[]
  categoriasFinanceiras   CategoriaFinanceira[]
  contasBancarias         ContaBancaria[]
  titulos                 Titulo[]
  auditLogs               AuditLog[]
  lancamentosBancarios    LancamentoBancario[]
  extratosImportados      ExtratoImportado[]
  orcamentos              Orcamento[]
  orcamentosSafra         OrcamentoSafra[]
  requisicoesIdempotentes RequisicaoIdempotente[]
  talhoes                 Talhao[]
  locaisArmazenamento     LocalArmazenamento[]
  configuracaoProducao    ConfiguracaoProducao?
  lotes                   Lote[]
  movimentosEstoque       MovimentoEstoque[]
  ajustesEstoque          AjusteEstoque[]
  recepcoesFruto          RecepcaoFruto[]
  pedidosVenda            PedidoVenda[]

  @@index([empresaId])
  @@map("filiais")
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresas                  UsuarioEmpresa[]
  auditLogs                 AuditLog[]
  baixasRegistradas         Baixa[]                  @relation("BaixaRegistradaPor")
  baixasAvaliadas           Baixa[]                  @relation("BaixaAvaliadaPor")
  anexos                    Anexo[]
  lancamentosBancarios      LancamentoBancario[]
  saldosBancariosInformados SaldoBancarioInformado[]
  extratosImportados        ExtratoImportado[]
  apiKeys                   ApiKey[]
  requisicoesIdempotentes   RequisicaoIdempotente[]
  movimentosEstoque         MovimentoEstoque[]
  ajustesEstoque            AjusteEstoque[]
  recepcoesFruto            RecepcaoFruto[]
  pedidosVenda              PedidoVenda[]

  @@map("usuarios")
}

model ApiKey {
  id          String    @id @default(uuid())
  usuarioId   String
  nome        String
  prefixo     String
  chaveHash   String    @unique
  ultimoUsoEm DateTime?
  revogadaEm  DateTime?
  criadoEm    DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("api_keys")
}

/// Proteção contra reenvio de POST na API v1 (cabeçalho `Idempotency-Key`).
/// Enquanto `statusHttp` é nulo a requisição original está em andamento; depois
/// guarda a resposta de sucesso, que é devolvida de novo em qualquer reenvio.
model RequisicaoIdempotente {
  id          String    @id @default(uuid())
  usuarioId   String
  filialId    String
  rota        String
  chave       String
  /// sha256 do corpo JSON; nulo em multipart (o boundary muda a cada envio).
  hashCorpo   String?
  statusHttp  Int?
  resposta    Json?
  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  filial  Filial  @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, filialId, rota, chave])
  @@map("requisicoes_idempotentes")
}

model UsuarioEmpresa {
  id        String   @id @default(uuid())
  usuarioId String
  empresaId String
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  filiais UsuarioEmpresaFilial[]

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@map("usuarios_empresas")
}

model UsuarioEmpresaFilial {
  id               String   @id @default(uuid())
  usuarioEmpresaId String
  filialId         String
  podeAlterar      Boolean  @default(false)
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  usuarioEmpresa UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id], onDelete: Cascade)
  filial         Filial         @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@unique([usuarioEmpresaId, filialId])
  @@index([filialId])
  @@map("usuarios_empresas_filiais")
}

model CentroCusto {
  id           String   @id @default(uuid())
  filialId     String
  nome         String
  codigo       String
  parentId     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  filial               Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  parent               CentroCusto?         @relation("CentroCustoHierarquia", fields: [parentId], references: [id])
  filhos               CentroCusto[]        @relation("CentroCustoHierarquia")
  titulos              Titulo[]
  lancamentosBancarios LancamentoBancario[]

  @@unique([filialId, codigo])
  @@index([filialId])
  @@map("centros_custo")
}

model CentroLucro {
  id           String   @id @default(uuid())
  filialId     String
  nome         String
  codigo       String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  filial               Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  titulos              Titulo[]
  lancamentosBancarios LancamentoBancario[]

  @@unique([filialId, codigo])
  @@index([filialId])
  @@map("centros_lucro")
}

model Safra {
  id           String             @id @default(uuid())
  filialId     String
  nome         String
  dataInicio   DateTime
  dataFim      DateTime
  status       StatusSafraProjeto @default(PLANEJADO)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  filial               Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  titulos              Titulo[]
  lancamentosBancarios LancamentoBancario[]
  orcamentosSafra      OrcamentoSafra[]
  recepcoesFruto       RecepcaoFruto[]

  @@unique([filialId, nome])
  @@index([filialId])
  @@map("safras")
}

model Projeto {
  id           String             @id @default(uuid())
  filialId     String
  nome         String
  codigo       String
  status       StatusSafraProjeto @default(PLANEJADO)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  filial               Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  titulos              Titulo[]
  lancamentosBancarios LancamentoBancario[]

  @@unique([filialId, codigo])
  @@index([filialId])
  @@map("projetos")
}

model CategoriaFinanceira {
  id           String                  @id @default(uuid())
  filialId     String
  nome         String
  tipo         TipoCategoriaFinanceira
  parentId     String?
  ativo        Boolean                 @default(true)
  criadoEm     DateTime                @default(now())
  atualizadoEm DateTime                @updatedAt

  filial                   Filial                 @relation(fields: [filialId], references: [id], onDelete: Cascade)
  parent                   CategoriaFinanceira?   @relation("CategoriaFinanceiraHierarquia", fields: [parentId], references: [id])
  filhos                   CategoriaFinanceira[]  @relation("CategoriaFinanceiraHierarquia")
  titulos                  Titulo[]
  lancamentosBancarios     LancamentoBancario[]
  orcamentos               Orcamento[]
  configuracoesCompraFruto ConfiguracaoProducao[] @relation("CategoriaCompraFruto")
  configuracoesVenda       ConfiguracaoProducao[] @relation("CategoriaVenda")

  @@index([filialId])
  @@map("categorias_financeiras")
}

model Orcamento {
  id                    String   @id @default(uuid())
  filialId              String
  categoriaFinanceiraId String
  ano                   Int
  mes                   Int
  valor                 Decimal  @db.Decimal(18, 2)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  filial              Filial              @relation(fields: [filialId], references: [id], onDelete: Cascade)
  categoriaFinanceira CategoriaFinanceira @relation(fields: [categoriaFinanceiraId], references: [id])

  @@unique([filialId, categoriaFinanceiraId, ano, mes])
  @@index([filialId])
  @@map("orcamentos")
}

model OrcamentoSafra {
  id           String   @id @default(uuid())
  filialId     String
  safraId      String
  valor        Decimal  @db.Decimal(18, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)
  safra  Safra  @relation(fields: [safraId], references: [id])

  @@unique([filialId, safraId])
  @@index([filialId])
  @@map("orcamentos_safra")
}

model Cliente {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  cnpjCpf      String?
  contato      String?
  email        String?
  telefone     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  meioPagamento     MeioPagamento?
  tipoChavePix      TipoChavePix?
  chavePix          String?
  bancoId           String?
  agencia           String?
  conta             String?
  tipoContaTerceiro TipoContaTerceiro?
  titularConta      String?

  classificacaoFiscalPadrao ClassificacaoFiscal?

  canalVenda          CanalVenda?
  municipio           String?
  enderecoEntrega     String?
  retiraNaPropriedade Boolean     @default(false)

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  banco        Banco?        @relation(fields: [bancoId], references: [id])
  titulos      Titulo[]
  pedidosVenda PedidoVenda[]

  @@unique([empresaId, cnpjCpf])
  @@index([empresaId])
  @@map("clientes")
}

model Fornecedor {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  cnpjCpf      String
  contato      String?
  email        String?
  telefone     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  meioPagamento     MeioPagamento?
  tipoChavePix      TipoChavePix?
  chavePix          String?
  bancoId           String?
  agencia           String?
  conta             String?
  tipoContaTerceiro TipoContaTerceiro?
  titularConta      String?

  classificacaoFiscalPadrao ClassificacaoFiscal?

  municipio String?

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  banco          Banco?          @relation(fields: [bancoId], references: [id])
  titulos        Titulo[]
  recepcoesFruto RecepcaoFruto[]

  @@unique([empresaId, cnpjCpf])
  @@index([empresaId])
  @@map("fornecedores")
}

model Banco {
  id     String @id @default(uuid())
  codigo String @unique
  nome   String

  contasBancarias ContaBancaria[]
  clientes        Cliente[]
  fornecedores    Fornecedor[]

  @@map("bancos")
}

model ContaBancaria {
  id           String            @id @default(uuid())
  filialId     String
  bancoId      String
  agencia      String
  conta        String
  tipo         TipoContaBancaria @default(CORRENTE)
  moeda        String            @default("BRL")
  saldoInicial Decimal           @default(0) @db.Decimal(18, 2)
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  filial                         Filial                   @relation(fields: [filialId], references: [id], onDelete: Cascade)
  banco                          Banco                    @relation(fields: [bancoId], references: [id])
  titulos                        Titulo[]
  baixas                         Baixa[]
  lancamentos                    LancamentoBancario[]
  saldosInformados               SaldoBancarioInformado[]
  extratosImportados             ExtratoImportado[]
  linhasExtrato                  LinhaExtrato[]
  pedidosVenda                   PedidoVenda[]
  configuracoesRecebimentoPadrao ConfiguracaoProducao[]   @relation("ContaRecebimentoPadrao")
  configuracoesCaixaPadrao       ConfiguracaoProducao[]   @relation("ContaCaixaPadrao")

  @@unique([filialId, bancoId, agencia, conta])
  @@index([filialId])
  @@map("contas_bancarias")
}

model AuditLog {
  id            String   @id @default(uuid())
  empresaId     String?
  filialId      String?
  usuarioId     String?
  entidade      String
  entidadeId    String
  acao          String
  valorAnterior Json?
  valorNovo     Json?
  criadoEm      DateTime @default(now())

  empresa Empresa? @relation(fields: [empresaId], references: [id])
  filial  Filial?  @relation(fields: [filialId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([filialId])
  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

enum TipoTitulo {
  PAGAR
  RECEBER
}

enum StatusParcela {
  EM_ABERTO
  A_VENCER
  VENCIDO
  PARCIALMENTE_PAGO
  PAGO
  CANCELADO
  RENEGOCIADO
}

enum StatusAprovacaoBaixa {
  PENDENTE
  APROVADO
  REJEITADO
}

model Titulo {
  id                    String     @id @default(uuid())
  filialId              String
  tipo                  TipoTitulo
  fornecedorId          String?
  clienteId             String?
  documento             String
  dataEmissao           DateTime
  dataCompetencia       DateTime
  categoriaFinanceiraId String
  centroCustoId         String?
  centroLucroId         String?
  safraId               String?
  projetoId             String?
  contaBancariaId       String?
  formaPagamento        String?
  ativo                 Boolean    @default(true)
  criadoEm              DateTime   @default(now())
  atualizadoEm          DateTime   @updatedAt

  classificacaoFiscal        ClassificacaoFiscal @default(FISCAL)
  tipoComprovante            TipoComprovante?
  numeroDocumentoFiscal      String?
  serieDocumentoFiscal       String?
  chaveAcesso                String?
  dataEmissaoDocumentoFiscal DateTime?
  motivoSemDocumento         String?

  filial              Filial              @relation(fields: [filialId], references: [id], onDelete: Cascade)
  fornecedor          Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  cliente             Cliente?            @relation(fields: [clienteId], references: [id])
  categoriaFinanceira CategoriaFinanceira @relation(fields: [categoriaFinanceiraId], references: [id])
  centroCusto         CentroCusto?        @relation(fields: [centroCustoId], references: [id])
  centroLucro         CentroLucro?        @relation(fields: [centroLucroId], references: [id])
  safra               Safra?              @relation(fields: [safraId], references: [id])
  projeto             Projeto?            @relation(fields: [projetoId], references: [id])
  contaBancaria       ContaBancaria?      @relation(fields: [contaBancariaId], references: [id])

  parcelas      Parcela[]
  anexos        Anexo[]
  recepcaoFruto RecepcaoFruto?
  pedidoVenda   PedidoVenda?

  @@index([filialId])
  @@index([fornecedorId])
  @@index([clienteId])
  @@index([filialId, classificacaoFiscal])
  @@index([filialId, chaveAcesso])
  @@map("titulos")
}

model Parcela {
  id              String        @id @default(uuid())
  tituloId        String
  numero          Int
  dataVencimento  DateTime
  valorOriginal   Decimal       @db.Decimal(18, 2)
  valorAtualizado Decimal       @db.Decimal(18, 2)
  status          StatusParcela @default(EM_ABERTO)
  parcelaOrigemId String?
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  titulo        Titulo    @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  parcelaOrigem Parcela?  @relation("RenegociacaoParcela", fields: [parcelaOrigemId], references: [id])
  renegociacoes Parcela[] @relation("RenegociacaoParcela")
  baixas        Baixa[]

  @@unique([tituloId, numero])
  @@index([tituloId])
  @@index([status])
  @@map("parcelas")
}

model Baixa {
  id              String               @id @default(uuid())
  parcelaId       String
  data            DateTime
  valorPago       Decimal              @db.Decimal(18, 2)
  valorJuros      Decimal              @default(0) @db.Decimal(18, 2)
  valorMulta      Decimal              @default(0) @db.Decimal(18, 2)
  valorDesconto   Decimal              @default(0) @db.Decimal(18, 2)
  contaBancariaId String
  usuarioId       String
  statusAprovacao StatusAprovacaoBaixa @default(PENDENTE)
  avaliadoPorId   String?
  avaliadoEm      DateTime?
  motivoRejeicao  String?
  criadoEm        DateTime             @default(now())

  parcela       Parcela              @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  contaBancaria ContaBancaria        @relation(fields: [contaBancariaId], references: [id])
  usuario       Usuario              @relation("BaixaRegistradaPor", fields: [usuarioId], references: [id])
  avaliadoPor   Usuario?             @relation("BaixaAvaliadaPor", fields: [avaliadoPorId], references: [id])
  lancamentos   LancamentoBancario[]
  pedidoVenda   PedidoVenda?

  @@index([parcelaId])
  @@map("baixas")
}

model Anexo {
  id           String   @id @default(uuid())
  tituloId     String
  url          String
  nomeArquivo  String
  tamanhoBytes Int
  usuarioId    String
  criadoEm     DateTime @default(now())

  titulo  Titulo  @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([tituloId])
  @@map("anexos")
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum OrigemLancamento {
  MANUAL
  BAIXA
  TRANSFERENCIA
}

enum StatusLinhaExtrato {
  NAO_CONCILIADO
  SUGESTAO
  CONCILIADO
  DIVERGENCIA_VALOR
  DIVERGENCIA_DATA
  DUPLICADO
}

model LancamentoBancario {
  id                    String           @id @default(uuid())
  filialId              String
  contaBancariaId       String
  data                  DateTime
  tipo                  TipoLancamento
  valor                 Decimal          @db.Decimal(18, 2)
  descricao             String
  origem                OrigemLancamento @default(MANUAL)
  conciliado            Boolean          @default(false)
  baixaId               String?
  transferenciaId       String?
  categoriaFinanceiraId String?
  centroCustoId         String?
  centroLucroId         String?
  safraId               String?
  projetoId             String?
  usuarioId             String
  criadoEm              DateTime         @default(now())

  // null apenas para TRANSFERENCIA (garantido por CHECK na migration); o default
  // mantém funcionando quem cria lançamento sem informar a classificação
  classificacaoFiscal ClassificacaoFiscal? @default(FISCAL)
  tipoComprovante     TipoComprovante?
  numeroComprovante   String?

  filial              Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  contaBancaria       ContaBancaria        @relation(fields: [contaBancariaId], references: [id])
  baixa               Baixa?               @relation(fields: [baixaId], references: [id])
  categoriaFinanceira CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id])
  centroCusto         CentroCusto?         @relation(fields: [centroCustoId], references: [id])
  centroLucro         CentroLucro?         @relation(fields: [centroLucroId], references: [id])
  safra               Safra?               @relation(fields: [safraId], references: [id])
  projeto             Projeto?             @relation(fields: [projetoId], references: [id])
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  linhaExtrato        LinhaExtrato?

  @@index([filialId])
  @@index([contaBancariaId])
  @@index([baixaId])
  @@index([filialId, classificacaoFiscal, data])
  @@map("lancamentos_bancarios")
}

model ExtratoImportado {
  id              String   @id @default(uuid())
  filialId        String
  contaBancariaId String
  nomeArquivo     String
  totalLinhas     Int
  linhasNovas     Int
  linhasIgnoradas Int
  usuarioId       String
  criadoEm        DateTime @default(now())

  filial        Filial         @relation(fields: [filialId], references: [id], onDelete: Cascade)
  contaBancaria ContaBancaria  @relation(fields: [contaBancariaId], references: [id])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  linhas        LinhaExtrato[]

  @@index([filialId])
  @@index([contaBancariaId])
  @@map("extratos_importados")
}

model LinhaExtrato {
  id                    String             @id @default(uuid())
  extratoImportadoId    String
  contaBancariaId       String
  data                  DateTime
  valor                 Decimal            @db.Decimal(18, 2)
  tipo                  TipoLancamento
  historico             String
  identificadorBancario String
  status                StatusLinhaExtrato @default(NAO_CONCILIADO)
  lancamentoBancarioId  String?            @unique
  criadoEm              DateTime           @default(now())

  extratoImportado   ExtratoImportado    @relation(fields: [extratoImportadoId], references: [id], onDelete: Cascade)
  contaBancaria      ContaBancaria       @relation(fields: [contaBancariaId], references: [id])
  lancamentoBancario LancamentoBancario? @relation(fields: [lancamentoBancarioId], references: [id])

  @@unique([contaBancariaId, identificadorBancario])
  @@index([contaBancariaId])
  @@index([extratoImportadoId])
  @@index([status])
  @@map("linhas_extrato")
}

model SaldoBancarioInformado {
  id              String   @id @default(uuid())
  contaBancariaId String
  data            DateTime
  saldo           Decimal  @db.Decimal(18, 2)
  usuarioId       String
  criadoEm        DateTime @default(now())

  contaBancaria ContaBancaria @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([contaBancariaId])
  @@map("saldos_bancarios_informados")
}

// ---------------------------------------------------------------------------
// Fase 7 — Produção, estoque e vendas (7a: cadastros e configuração)
// ---------------------------------------------------------------------------

enum CategoriaProduto {
  FRUTO
  POLPA
}

enum Conservacao {
  IN_NATURA
  RESFRIADO
  CONGELADO
}

enum TipoLocalArmazenamento {
  CAMARA_FRIA
  FREEZER
  REFRIGERADOR
  RECEPCAO
  OUTRO
}

enum CanalVenda {
  BATEDOR
  ATACADO
  VAREJO
  RESTAURANTE
  INDUSTRIA
  CONSUMIDOR_FINAL
  OUTRO
}

model Fruta {
  id                 String   @id @default(uuid())
  empresaId          String
  nome               String
  custoPadraoKg      Decimal  @default(0) @db.Decimal(18, 4)
  exigeBranqueamento Boolean  @default(false)
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtos Produto[]
  talhoes  Talhao[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("frutas")
}

model Produto {
  id                String           @id @default(uuid())
  empresaId         String
  codigo            String
  descricao         String
  categoria         CategoriaProduto
  frutaId           String
  conservacao       Conservacao
  validadeDias      Int
  precoReferenciaKg Decimal?         @db.Decimal(18, 4)
  armazenamento     String?
  unidadeComercial  String?
  fatorUnidadeKg    Decimal?         @db.Decimal(18, 3)
  ativo             Boolean          @default(true)
  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fruta     Fruta           @relation(fields: [frutaId], references: [id], onDelete: Restrict)
  lotes     Lote[]
  recepcoes RecepcaoFruto[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("produtos")
}

model Insumo {
  id            String   @id @default(uuid())
  empresaId     String
  nome          String
  unidade       String
  custoUnitario Decimal  @db.Decimal(18, 4)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("insumos")
}

model Talhao {
  id           String   @id @default(uuid())
  filialId     String
  nome         String
  frutaId      String
  areaHa       Decimal  @db.Decimal(10, 2)
  anoPlantio   Int?
  espacamento  String?
  observacao   String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  filial    Filial          @relation(fields: [filialId], references: [id], onDelete: Cascade)
  fruta     Fruta           @relation(fields: [frutaId], references: [id], onDelete: Restrict)
  recepcoes RecepcaoFruto[]

  @@unique([filialId, nome])
  @@index([filialId])
  @@map("talhoes")
}

model LocalArmazenamento {
  id           String                 @id @default(uuid())
  filialId     String
  nome         String
  tipo         TipoLocalArmazenamento
  temperatura  String?
  capacidadeKg Decimal?               @db.Decimal(18, 3)
  ativo        Boolean                @default(true)
  criadoEm     DateTime               @default(now())
  atualizadoEm DateTime               @updatedAt

  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)
  lotes  Lote[]

  @@unique([filialId, nome])
  @@index([filialId])
  @@map("locais_armazenamento")
}

model ConfiguracaoProducao {
  filialId                      String   @id
  registroAdepara               String?
  alertaVencimentoCongeladoDias Int      @default(30)
  alertaVencimentoResfriadoDias Int      @default(1)
  branqueamentoTemperaturaMinC  Decimal  @default(80) @db.Decimal(5, 1)
  branqueamentoTempoMinS        Int      @default(10)
  toleranciaBalancoMassa        Decimal  @default(0.03) @db.Decimal(5, 4)
  categoriaCompraFrutoId        String?
  prazoPagamentoProdutorDias    Int      @default(0)
  categoriaVendaId              String?
  contaRecebimentoPadraoId      String?
  contaCaixaPadraoId            String?
  criadoEm                      DateTime @default(now())
  atualizadoEm                  DateTime @updatedAt

  filial                 Filial               @relation(fields: [filialId], references: [id], onDelete: Cascade)
  categoriaCompraFruto   CategoriaFinanceira? @relation("CategoriaCompraFruto", fields: [categoriaCompraFrutoId], references: [id], onDelete: SetNull)
  categoriaVenda         CategoriaFinanceira? @relation("CategoriaVenda", fields: [categoriaVendaId], references: [id], onDelete: SetNull)
  contaRecebimentoPadrao ContaBancaria?       @relation("ContaRecebimentoPadrao", fields: [contaRecebimentoPadraoId], references: [id], onDelete: SetNull)
  contaCaixaPadrao       ContaBancaria?       @relation("ContaCaixaPadrao", fields: [contaCaixaPadraoId], references: [id], onDelete: SetNull)

  @@map("configuracoes_producao")
}

// Fase 7b — recepção de fruto e estoque

enum OrigemRecepcao {
  PROPRIA
  TERCEIRO
}

enum QualidadeFruto {
  A
  B
  C
}

enum StatusRecepcao {
  ATIVA
  CANCELADA
}

enum OrigemLote {
  RECEPCAO
  PRODUCAO
}

enum TipoMovimentoEstoque {
  ENTRADA
  ESTORNO_RECEPCAO
  AJUSTE
  VENDA
  ESTORNO_VENDA
}

enum MotivoAjusteEstoque {
  VENCIDO
  AVARIA
  AMOSTRA
  INVENTARIO
  CONSUMO_INTERNO
  OUTRO
}

model Lote {
  id                  String     @id @default(uuid())
  filialId            String
  codigo              String
  codigoManual        Boolean    @default(false)
  produtoId           String
  origem              OrigemLote
  data                DateTime
  validade            DateTime
  localId             String
  quantidadeInicialKg Decimal    @db.Decimal(18, 3)
  saldoKg             Decimal    @db.Decimal(18, 3)
  custoKg             Decimal    @db.Decimal(18, 4)
  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt

  filial           Filial             @relation(fields: [filialId], references: [id], onDelete: Cascade)
  produto          Produto            @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  local            LocalArmazenamento @relation(fields: [localId], references: [id], onDelete: Restrict)
  movimentos       MovimentoEstoque[]
  ajustes          AjusteEstoque[]
  recepcao         RecepcaoFruto?
  itensPedidoVenda ItemPedidoVenda[]

  @@unique([filialId, codigo])
  @@index([filialId, produtoId])
  @@index([filialId, validade])
  @@map("lotes")
}

model MovimentoEstoque {
  id           String               @id @default(uuid())
  filialId     String
  loteId       String
  data         DateTime
  tipo         TipoMovimentoEstoque
  quantidadeKg Decimal              @db.Decimal(18, 3)
  ajusteId     String?              @unique
  itemPedidoId String?
  usuarioId    String
  criadoEm     DateTime             @default(now())

  filial     Filial           @relation(fields: [filialId], references: [id], onDelete: Cascade)
  lote       Lote             @relation(fields: [loteId], references: [id], onDelete: Cascade)
  ajuste     AjusteEstoque?   @relation(fields: [ajusteId], references: [id])
  itemPedido ItemPedidoVenda? @relation(fields: [itemPedidoId], references: [id])
  usuario    Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([loteId])
  @@index([itemPedidoId])
  @@index([filialId, data])
  @@map("movimentos_estoque")
}

model AjusteEstoque {
  id           String              @id @default(uuid())
  filialId     String
  data         DateTime
  loteId       String
  quantidadeKg Decimal             @db.Decimal(18, 3)
  motivo       MotivoAjusteEstoque
  observacao   String?
  usuarioId    String
  criadoEm     DateTime            @default(now())

  filial    Filial            @relation(fields: [filialId], references: [id], onDelete: Cascade)
  lote      Lote              @relation(fields: [loteId], references: [id], onDelete: Cascade)
  usuario   Usuario           @relation(fields: [usuarioId], references: [id])
  movimento MovimentoEstoque?

  @@index([filialId, data])
  @@map("ajustes_estoque")
}

model RecepcaoFruto {
  id                 String          @id @default(uuid())
  filialId           String
  loteId             String          @unique
  data               DateTime
  produtoId          String
  origem             OrigemRecepcao
  talhaoId           String?
  fornecedorId       String?
  pesoBrutoKg        Decimal         @db.Decimal(18, 3)
  descarteKg         Decimal         @default(0) @db.Decimal(18, 3)
  precoKg            Decimal         @db.Decimal(18, 4)
  valorTotal         Decimal         @db.Decimal(18, 2)
  qualidade          QualidadeFruto?
  documento          String?
  observacao         String?
  safraId            String?
  tituloId           String?         @unique
  status             StatusRecepcao  @default(ATIVA)
  motivoCancelamento String?
  usuarioId          String
  criadoEm           DateTime        @default(now())
  atualizadoEm       DateTime        @updatedAt

  filial     Filial      @relation(fields: [filialId], references: [id], onDelete: Cascade)
  lote       Lote        @relation(fields: [loteId], references: [id], onDelete: Cascade)
  produto    Produto     @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  talhao     Talhao?     @relation(fields: [talhaoId], references: [id], onDelete: Restrict)
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  safra      Safra?      @relation(fields: [safraId], references: [id], onDelete: SetNull)
  titulo     Titulo?     @relation(fields: [tituloId], references: [id], onDelete: SetNull)
  usuario    Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([filialId, data])
  @@map("recepcoes_fruto")
}

// Fase 7c — vendas e entregas

enum FormaPagamentoVenda {
  DINHEIRO
  PIX
  TRANSFERENCIA
  CARTAO
  A_PRAZO
}

enum StatusPedidoVenda {
  CONFIRMADO
  CANCELADO
}

enum StatusEntrega {
  PENDENTE
  EM_ROTA
  ENTREGUE
  CANCELADA
}

model PedidoVenda {
  id                    String              @id @default(uuid())
  filialId              String
  /// Sequencial por filial (RN-02); nunca muda nem é reaproveitado.
  numero                Int
  data                  DateTime
  clienteId             String
  canal                 CanalVenda?
  formaPagamento        FormaPagamentoVenda
  /// Só A_PRAZO.
  vencimento            DateTime?
  /// Conta da baixa automática (à vista).
  contaBancariaId       String?
  retiraNaPropriedade   Boolean             @default(false)
  numeroDocumentoFiscal String?
  observacao            String?
  status                StatusPedidoVenda   @default(CONFIRMADO)
  motivoCancelamento    String?
  canceladoEm           DateTime?
  /// Título a RECEBER.
  tituloId              String?             @unique
  /// Baixa criada pela venda à vista; o cancelamento a apaga.
  baixaAutomaticaId     String?             @unique
  usuarioId             String
  criadoEm              DateTime            @default(now())
  atualizadoEm          DateTime            @updatedAt

  filial          Filial            @relation(fields: [filialId], references: [id], onDelete: Cascade)
  cliente         Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  contaBancaria   ContaBancaria?    @relation(fields: [contaBancariaId], references: [id], onDelete: Restrict)
  titulo          Titulo?           @relation(fields: [tituloId], references: [id], onDelete: SetNull)
  baixaAutomatica Baixa?            @relation(fields: [baixaAutomaticaId], references: [id], onDelete: SetNull)
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])
  itens           ItemPedidoVenda[]
  entrega         Entrega?

  @@unique([filialId, numero])
  @@index([filialId, data])
  @@map("pedidos_venda")
}

model ItemPedidoVenda {
  id                     String  @id @default(uuid())
  pedidoId               String
  loteId                 String
  quantidadeKg           Decimal @db.Decimal(18, 3)
  precoKg                Decimal @db.Decimal(18, 4)
  /// Custo do lote no momento da venda (RN-22).
  custoKg                Decimal @db.Decimal(18, 4)
  /// D-03: só quando o lote estava vencido na data do pedido.
  motivoLiberacaoVencido String?

  pedido     PedidoVenda        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  lote       Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimentos MovimentoEstoque[]

  @@index([pedidoId])
  @@index([loteId])
  @@map("itens_pedido_venda")
}

/// Só existe para pedido com `retiraNaPropriedade = false` (D-16).
model Entrega {
  pedidoId      String        @id
  dataPrevista  DateTime
  dataRealizada DateTime?
  endereco      String?
  responsavel   String?
  recebidoPor   String?
  observacao    String?
  status        StatusEntrega @default(PENDENTE)
  atualizadoEm  DateTime      @updatedAt

  pedido PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([status, dataPrevista])
  @@map("entregas")
}
