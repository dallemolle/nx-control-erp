# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/nx_control_erp
# Producao (Neon): use a connection pooled URL para DATABASE_URL e a direct connection para DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nx_control_erp"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nx_control_erp"

AUTH_SECRET="troque-por-um-valor-aleatorio-gerado-com-npx-auth-secret"

# Token read-write de um store do Vercel Blob — usado pelos anexos de titulo
# (upload, download autenticado e exclusao). Sem ele os anexos falham em runtime;
# em dev local pode ficar vazio se voce nao for exercitar anexos.
BLOB_READ_WRITE_TOKEN=

# Id de um segundo store do Vercel Blob, esse configurado como PUBLICO (o de
# cima, dos anexos, e privado) — usado so pelo logo de empresa, que precisa
# ser publico pra a imagem aparecer na sidebar sem exigir login. Com dois
# stores conectados ao projeto na Vercel, o SDK precisa desse id explicito
# pra saber qual store usar via OIDC (autenticacao automatica, sem token
# manual, quando rodando na Vercel). O valor vem do proprio dashboard da
# Vercel (Storage > o store publico > variavel *_STORE_ID nas Environment
# Variables do projeto). Em dev local, so funciona depois de rodar
# `vercel link && vercel env pull` uma vez (o store precisa ter sido
# conectado com o ambiente "Development" marcado); sem isso, upload de
# logo falha localmente mas os demais testes/funcionalidades nao dependem
# disso.
BLOB_LOGO_READ_WRITE_TOKEN_STORE_ID=
